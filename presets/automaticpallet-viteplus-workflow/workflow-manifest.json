{
  "schemaVersion": 2,
  "integrationBranch": "preview",
  "productionBranch": "main",
  "worktrees": {
    "mode": "detached",
    "base": "origin/preview",
    "createTask": "vp run agent:worktree:create"
  },
  "verification": {
    "doctor": "vp run agent:doctor",
    "task": "vp run agent:verify",
    "checkpoint": "vp staged",
    "exactTestedShaRequired": true,
    "evidence": { "default": "local-redacted", "publicUploadRequiresOptIn": true }
  },
  "promotion": { "base": "main", "head": "preview", "humanMergeRequired": true },
  "externalWrites": { "default": "forbidden", "requiresExplicitUserInstruction": true },
  "cloudflare": {
    "gitIntegrationRequired": true,
    "publicAppsRequireExactPreviewShaUrl": true,
    "dataServicesRequireNonPublicPreview": true
  },
  "sharedResources": ["ports", "databases", "credentials", "dependency-lockfiles"],
  "packageInterface": { "allowed": ["vp", "vpr"], "rawPackageManagerTasksSupported": false }
}
